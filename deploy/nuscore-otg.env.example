# Copy to /etc/nuscore-otg.env (readable by nacl_pam_admin only).

APP_ENV=production
LOG_LEVEL=INFO

# Path prefix nginx serves the app under.
ROOT_PATH=/nuscore_claudecode

# Uploads, job state and logs. Uploaded data is deleted once a training job
# on it succeeds; untrained uploads expire after 24 hours.
DATA_ROOT=/mnt/harshitrathi/mlpipeline-data
MAX_UPLOAD_GB=20
MAX_CONCURRENT_JOBS=2

# Local LLM only: data never leaves the host.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5:7b

# Training on GPUs 2-3 (0-1 are reserved for Ollama).
CUDA_VISIBLE_DEVICES=2,3

# Keep model/tool caches on the 3 TB /mnt volume, not the small /home partition.
HF_HOME=/mnt/harshitrathi/.hf-cache
PIP_CACHE_DIR=/mnt/harshitrathi/.pip-cache

# CPU threads per training job (2 concurrent jobs on 64 cores).
JOB_THREADS=16
